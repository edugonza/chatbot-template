# Matrix
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=@mybot:matrix.org
MATRIX_ACCESS_TOKEN=
MATRIX_DEVICE_ID=

# Optional: encrypts the SQLite state/crypto stores at rest. If you set it,
# set it for scripts/login.py too, and never change it afterwards.
# MATRIX_STORE_PASSPHRASE=

# Comma-separated allowlist — at least one of these must be set. Only users
# in MATRIX_ALLOWED_USERS can verify the bot.
MATRIX_ALLOWED_USERS=@you:matrix.org
MATRIX_ALLOWED_ROOMS=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# How many of the most recent turns get sent to the model per reply.
# BOT_HISTORY_BATCH controls how many turns get dropped at once when the
# window advances, so the prompt prefix stays stable for implicit caching.
# BOT_HISTORY_LENGTH=200
# BOT_HISTORY_BATCH=50
# BOT_HISTORY_DB_PATH=/data/store/history.db

# Logging: LOG_LEVEL for the Python side, MATRIX_SDK_LOG_LEVEL for the Rust SDK.
# LOG_LEVEL=INFO
# MATRIX_SDK_LOG_LEVEL=warn

# Only used once, by scripts/login.py — never set this for the running bot service.
# MATRIX_PASSWORD=
